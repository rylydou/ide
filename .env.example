# Postgres (used by the `db` service in compose.yaml)
POSTGRES_USER=ide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ide

# App
# In compose this is derived from the POSTGRES_* vars above; set it directly for local `bun run dev`.
DATABASE_URL=postgres://ide:change-me@localhost:5432/ide
# Required by svelte-adapter-bun for CSRF checks. Must match the public URL exactly.
ORIGIN=http://localhost:3000
# Grants admin sign-up at /register/admin
ADMIN_SECRET=change-me
# Optional
APP_PORT=3000
BODY_SIZE_LIMIT=1M

# Only needed once, for `bun run db:import-turso`. Remove afterwards.
# DB_URL=libsql://...
# DB_TOKEN=...
