{
	"name": "builder",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev --host",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview --host",
		"start": "bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:import-turso": "bun scripts/import-from-turso.ts"
	},
	"devDependencies": {
		"@iconify/tools": "^5.0.14",
		"@iconify/utils": "^3.1.5",
		"@libsql/client": "^0.10.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/bun": "^1.4.1",
		"@unocss/extractor-svelte": "^66.10.0",
		"drizzle-kit": "1.0.0-rc.4",
		"svelte": "^5.57.0",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"drizzle-orm": "1.0.0-rc.4",
		"emmet-monaco-es": "^5.7.0",
		"monaco-editor": "^0.56.0",
		"svelte-splitpanes": "^8.0.12",
		"unocss": "^66.10.0",
		"zod": "^4.5.4"
	}
}
